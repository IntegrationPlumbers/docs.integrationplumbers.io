---
import products from '../products.json';
import ProductMark from './ProductMark.astro';
const list = Object.values(products) as any[];
---

<div class="grid not-content">
  {list.map((p) => (
    <article class="card">
      <header>
        <ProductMark product={p.key} size="lg" />
        <div class="t">
          <h2><a href={`/${p.key}/`}>{p.fullName ?? p.name}</a></h2>
          <span class="status">{p.status}</span>
        </div>
      </header>
      <p class="sum">{p.summary}</p>
      <dl class="builds">
        {p.builds.map((b: any) => (
          <div><dt>EM {b.em}</dt><dd>{b.build}</dd></div>
        ))}
      </dl>
      <ul class="supports">
        {p.supports.map((s: string) => <li>{s}</li>)}
      </ul>
      <nav class="go" aria-label={`${p.name} guide`}>
        <a href={`/${p.key}/getting-started.html`}>Getting started</a>
        <a href={`/${p.key}/whats-new.html`}>What's new</a>
        <a href={`/${p.key}/`} class="all">Full guide</a>
      </nav>
    </article>
  ))}
</div>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.25rem;
    border: 1px solid var(--ip-hairline);
    border-radius: 12px;
    background: var(--ip-card);
    transition: border-color 0.15s;
    position: relative;
  }
  .card:hover { border-color: var(--sl-color-gray-4); }
  header { display: flex; gap: 0.85rem; align-items: center; }
  .t { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  h2 { margin: 0; font-size: 1.2rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; }
  h2 a { color: var(--sl-color-white); text-decoration: none; }
  h2 a:hover { color: var(--sl-color-accent); }
  .status { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ip-ok-fg); }
  .sum { margin: 0; color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); line-height: 1.55; }
  .builds { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0; }
  .builds div { padding: 0.5rem 0.65rem; border-radius: 8px; background: var(--ip-surface); border: 1px solid var(--ip-hairline); }
  dt { font-size: 0.75rem; color: var(--sl-color-gray-3); }
  dd { margin: 0.1rem 0 0; font-family: var(--sl-font-mono); font-size: var(--sl-text-sm); color: var(--sl-color-white); font-variant-numeric: tabular-nums; }
  .supports { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; padding: 0; margin: 0; }
  .supports li { font-size: var(--sl-text-xs); padding: 0.15rem 0.55rem; border: 1px dashed var(--sl-color-gray-5); border-radius: 999px; color: var(--sl-color-gray-2); }
  .go { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--ip-hairline); font-size: var(--sl-text-sm); }
  .go a { color: var(--sl-color-gray-2); text-decoration: none; }
  .go a:hover { color: var(--sl-color-accent); }
  .go .all { margin-inline-start: auto; color: var(--sl-color-accent); font-weight: 600; }
  @media (max-width: 52rem) { .grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
