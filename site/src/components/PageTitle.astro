---
const PAGE_TITLE_ID = '_top';
import products from '../products.json';
import ProductMark from './ProductMark.astro';

const { entry, id } = Astro.locals.starlightRoute;
const data = entry.data as any;
const product = data.product as
  | { key: string; name: string; status: string; builds: { build: string; em: string }[]; date?: string; supports: string[] }
  | undefined;
const keys = Object.keys(products);
const productNames = Object.values(products).map((p: any) => p.fullName ?? p.name);
const names = productNames.length <= 2 ? productNames.join(' and ') : `${productNames.slice(0, -1).join(', ')}, and ${productNames[productNames.length - 1]}`;
const currentKey = keys.find((k) => id === k || id.startsWith(k + '/'));
const isHome = id === '' || id === 'index';
const markdownHref = currentKey && !isHome ? `/${id}.md` : undefined;

const quick = product
  ? [
      { href: `/${product.key}/getting-started.html`, title: 'Getting started', text: 'Install the plug-in and see a target with real data.' },
      { href: `/${product.key}/whats-new.html`, title: "What's new", text: 'What changed in this release, and what to read first.' },
      { href: `/${product.key}/troubleshooting.html`, title: 'Troubleshooting', text: 'Problems listed by the exact message you see.' },
    ]
  : [];
---

{isHome ? (
  <div class="home-hero">
    <p class="eyebrow">Oracle Enterprise Manager plug-ins</p>
    <h1 id={PAGE_TITLE_ID}>Integration Plumbers documentation</h1>
    <p class="lead">
      Install, configure, and run the plug-ins that monitor {names} from Oracle Enterprise Manager 13.5 and 24ai.
    </p>
  </div>
) : product ? (
  <div class="product-hero">
    <div class="ph-top">
      <ProductMark product={product.key} size="lg" />
      <p class="eyebrow">Oracle Enterprise Manager plug-in</p>
    </div>
    <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
    <div class="chips">
      <span class="chip status">{product.status}</span>
      {product.builds.map((b) => (
        <span class="chip build"><span class="em">EM {b.em}</span><code>{b.build}</code></span>
      ))}
      {product.date && <span class="chip quiet">{product.date}</span>}
    </div>
    <div class="chips supports">
      {product.supports.map((s) => <span class="chip support">{s}</span>)}
    </div>
    <div class="quick">
      {quick.map((q) => (
        <a class="qcard" href={q.href}>
          <span class="qt">{q.title}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5l4.5 4.5L6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          <span class="qx">{q.text}</span>
        </a>
      ))}
    </div>
  </div>
) : (
  <div class="doc-title">
    {currentKey && (
      <a class="eyebrow crumb" href={`/${currentKey}/`}>{(products as any)[currentKey].fullName ?? (products as any)[currentKey].name} plug-in</a>
    )}
    <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
    {markdownHref && (
      <div class="tools">
        <button class="tool" type="button" data-copy-md={markdownHref}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M3 10.5V3.5A1 1 0 0 1 4 2.5h6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
          <span>Copy page as Markdown</span>
        </button>
        <a class="tool" href={markdownHref}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.5h11v7h-11z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><path d="M4.5 9.5v-3l1.5 1.5 1.5-1.5v3M10.5 6.5v3m-1.2-1.2 1.2 1.2 1.2-1.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>View Markdown</span>
        </a>
      </div>
    )}
  </div>
)}

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-md]')) {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span')!;
      const original = label.textContent;
      try {
        const res = await fetch(btn.dataset.copyMd!);
        const text = await res.text();
        await navigator.clipboard.writeText(text);
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Copy failed. Use View Markdown.';
      }
      setTimeout(() => (label.textContent = original), 2000);
    });
  }
</script>

<style>
  h1 {
    margin-top: 0.25rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
  }
  .crumb { text-decoration: none; display: inline-block; margin-top: 1rem; }
  .crumb:hover { text-decoration: underline; }

  .tools { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--ip-hairline);
    border-radius: 6px;
    background: var(--ip-card);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    cursor: pointer;
  }
  .tool:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  .tool:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .tool svg { width: 0.95rem; height: 0.95rem; }

  .home-hero { padding-block: 2.5rem 0.5rem; max-width: 44rem; }
  .home-hero h1 { font-size: clamp(2rem, 4.5vw, 2.9rem); margin-top: 0.6rem; }
  .lead { font-size: var(--sl-text-lg); color: var(--sl-color-gray-2); margin-top: 0.9rem; line-height: 1.6; }

  .product-hero { padding-top: 1rem; }
  .ph-top { display: flex; align-items: center; gap: 0.75rem; }
  .product-hero h1 { margin-top: 0.75rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.9rem; }
  .chips.supports { margin-top: 0.5rem; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    border: 1px solid var(--ip-hairline);
    background: var(--ip-card);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .chip.status { background: var(--ip-ok-bg); color: var(--ip-ok-fg); border-color: transparent; font-weight: 600; }
  .chip.build { background: var(--sl-color-accent-low); border-color: transparent; color: var(--sl-color-accent-high); }
  .chip.build .em { font-weight: 600; }
  .chip.build code { font-family: var(--sl-font-mono); background: none; border: 0; padding: 0; font-size: inherit; color: inherit; }
  .chip.support { border-style: dashed; }

  .quick { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.75rem; margin-top: 1.75rem; }
  .qcard {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--ip-hairline);
    border-radius: 10px;
    background: var(--ip-card);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .qcard:hover { border-color: var(--sl-color-accent); transform: translateY(-1px); }
  .qt { display: flex; align-items: center; justify-content: space-between; font-weight: 600; color: var(--sl-color-white); }
  .qt svg { width: 1rem; height: 1rem; color: var(--sl-color-accent); }
  .qx { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); line-height: 1.45; }
  @media (prefers-reduced-motion: reduce) { .qcard { transition: none; } .qcard:hover { transform: none; } }
</style>
