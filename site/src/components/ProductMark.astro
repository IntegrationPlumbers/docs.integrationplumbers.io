---
// A small monogram tile per plug-in. Avoids vendor logos (trademarks) while staying recognizable.
interface Props { product: string; size?: 'sm' | 'md' | 'lg' }
const { product, size = 'md' } = Astro.props;
const labels: Record<string, string> = { postgresql: 'Pg', mysql: 'My', mssql: 'Ms', db2: 'Db2' };
---

<span class:list={['mark', size]} aria-hidden="true">{labels[product] ?? product.slice(0, 2)}</span>

<style>
  .mark {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 7px;
    background: var(--ip-charcoal);
    color: #fff;
    font-family: var(--sl-font-mono);
    font-weight: 500;
    letter-spacing: -0.02em;
    position: relative;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ip-sky) 35%, transparent);
  }
  .mark::after {
    content: '';
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 34%;
    height: 34%;
    border-radius: 2px;
    background: var(--ip-sky);
    box-shadow: -3px -3px 0 0 var(--ip-blue);
  }
  .sm { width: 1.6rem; height: 1.6rem; font-size: 0.625rem; }
  .md { width: 2.1rem; height: 2.1rem; font-size: 0.75rem; }
  .lg { width: 2.75rem; height: 2.75rem; font-size: 0.9rem; border-radius: 9px; }
  :global([data-theme='dark']) .mark { background: #2a2d2c; }
</style>
